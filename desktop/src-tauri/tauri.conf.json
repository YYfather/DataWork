{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataWork",
  "version": "0.4.9",
  "identifier": "com.datawork.statistics",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "DataWork",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8765; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data: http://127.0.0.1:8765; style-src 'self' 'unsafe-inline' http://127.0.0.1:8765; script-src 'self' 'unsafe-inline' http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/datawork-sidecar"
    ]
  }
}
